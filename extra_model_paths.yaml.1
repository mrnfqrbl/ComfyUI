#config for comfyui
#your base path should be either an existing comfy install or a central folder where you store all of your models, loras, etc.

comfyui:
     base_path: /content/drive/MyDrive/ComfyUI/mx  # ComfyUI 根目录
     # You can use is_default to mark that these folders should be listed first, and used as the default dirs for eg downloads
     #is_default: true
     checkpoints: ckpt  # 相对于 ComfyUI 根目录
     clip: clip/  # 相对于 ComfyUI 根目录
     clip_vision: clip_vision/  # 相对于 ComfyUI 根目录
     configs: configs/  # 相对于 ComfyUI 根目录
     controlnet: controlnet/  # 相对于 ComfyUI 根目录
     diffusion_models: |
                  diffusion_models
                  unet
     embeddings: embeddings/  # 相对于 ComfyUI 根目录
     loras: lora  # 相对于 ComfyUI 根目录
     upscale_models: upscale_models/  # 相对于 ComfyUI 根目录
     vae: vae  # 相对于 ComfyUI 根目录

